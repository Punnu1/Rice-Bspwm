[colors]
background = #000000
background-alt = #000000
foreground = #ffffff
foreground-alt = #ffffff
primary = #ffffff
secondary = #888888
alert = #ed333b
disabled = #707880

[bar/example]
;monitor = ${env:MONITOR:HDMI-1}
width = 100%
height = 17pt
offset-x = 0px
offset-y = 0px
radius = 0
fixed-center = true
center-info = true
enable-ipc = true

background = ${colors.background}
foreground = ${colors.foreground}

;line-size = 2
;line-offset = -2
;line-color = ${colors.foreground}

border-size = 0
border-color = #000000

padding-left = 2
padding-right = 2

module-margin-left = 1
module-margin-right = 1

tray-position = none

font-0 = "JetBrainsMono Nerd Font:style=regular:size=8;1"


modules-left = bspwm crash
modules-center = date player 
modules-right = backlight pulseaudio memory cpu nm-icon wlan bt eth temperature battery

wm-restack = bspwm
override-redirect = false 

;scroll-up = bspwm-wsnext
;scroll-down = bspwm-wsprev

cursor-click = pointer
cursor-scroll = ns-resize

